# Copy to .env and fill in.
DATABASE_URL=postgres://pitchbox:pitchbox@127.0.0.1:5434/pitchbox
# Absolute path to your pitchbox repo root - used by the daemon and CLI.
PITCHBOX_ROOT=.
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string-0000000000000000000000000000
WEB_PORT=5180

# Secret the daemon sends as `Authorization: Bearer <token>` on its own
# POST /api/run dispatch calls (the only way it can start a scheduled or
# keyword-triggered campaign - see docs/daemon.md). Only required when
# PITCHBOX_AUTH=on: without it, that dispatch gets a 401 and no cron
# campaign can ever run (#378). A secret of its own, never reused from
# ENCRYPTION_KEY or anything else here, and it must differ per environment.
# PITCHBOX_INTERNAL_TOKEN=

# Boot the daemon loops inside the web server instead of running a separate
# `pitchbox daemon` process. Recommended for single-host self-hosters.
# PITCHBOX_EMBED_DAEMON=1

# AI Gateway key, used by the model configuration page in the instance admin
# area to list the models that can be picked (#411) and, once the SDK runner
# lands (#416), to reach the models themselves. Optional: with no key the page
# still saves a model id typed by hand, and every job falls back to its coded
# default.
# AI_GATEWAY_API_KEY=
